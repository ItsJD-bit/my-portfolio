<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Contact — JD</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- PAGE TRANSITION -->

    <div
        class="page-transition"
        aria-hidden="true"
    >

        <div class="transition-line"></div>

    </div>



    <!-- HEADER -->

    <header class="site-header">

        <a
            href="/"
            class="logo"
        >
            JD/
        </a>


        <nav class="navigation">

            <a href="/">
                Home
            </a>

            <a href="/about">
                About
            </a>

            <a href="/projects">
                Projects
            </a>

            <a
                href="/contact"
                class="active"
            >
                Contact
            </a>

        </nav>

    </header>



    <!-- MAIN -->

    <main>


        <!-- CONTACT HERO -->

        <section class="contact-page">

            <div class="hero-label">
                CONTACT / 03
            </div>


            <h1>
                LET'S<br>
                TALK.
            </h1>


            <div class="contact-intro">

                <p>
                    Have an idea, project, or just want
                    to say hello?
                </p>


                <a
                    href="mailto:your@email.com"
                    class="button"
                >
                    SEND AN EMAIL →
                </a>

            </div>

        </section>



        <!-- CONTACT DETAILS -->

        <section class="contact-details">


            <!-- EMAIL -->

            <div class="contact-detail">

                <span class="eyebrow">
                    EMAIL
                </span>


                <a
                    href="mailto:your@email.com"
                    class="contact-value"
                >
                    your@email.com
                </a>

            </div>



            <!-- SOCIAL -->

            <div class="contact-detail">

                <span class="eyebrow">
                    SOCIAL
                </span>


                <div class="contact-socials">

                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        GITHUB ↗
                    </a>


                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LINKEDIN ↗
                    </a>

                </div>

            </div>



            <!-- LOCATION -->

            <div class="contact-detail">

                <span class="eyebrow">
                    LOCATION
                </span>


                <p class="contact-value">
                    PHILIPPINES
                </p>

            </div>


        </section>



        <!-- DIRECT CONTACT -->

        <section class="contact-direct">

            <div class="section-number">
                01
            </div>


            <div>

                <span class="eyebrow">
                    PREFER EMAIL?
                </span>


                <h2>
                    DROP ME A LINE.
                </h2>


                <a
                    href="mailto:your@email.com"
                    class="contact-email"
                >
                    your@email.com →
                </a>

            </div>

        </section>


    </main>



    <!-- FOOTER -->

    <footer class="site-footer">

        <span>
            © 2026 JD
        </span>


        <span>
            BUILT WITH NODE.JS
        </span>

    </footer>



    <!-- CUSTOM CURSOR -->

    <div class="custom-cursor"></div>



    <script src="/js/main.js"></script>

</body>

</html>